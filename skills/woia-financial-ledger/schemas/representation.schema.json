{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trusted authority port representation proof",
  "oneOf": [
    {
      "type": "object", "required": ["applicable"], "additionalProperties": false,
      "properties": { "applicable": { "const": false } }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["applicable", "authenticated", "accepted", "current", "revoked", "principal_ref", "grant_ref", "source_ref", "revision", "digest_sha256", "org_id", "scope_id", "task_id", "action", "command_digest", "valid_from", "valid_until"],
      "properties": {
        "applicable": { "const": true }, "authenticated": { "const": true },
        "accepted": { "const": true }, "current": { "const": true }, "revoked": { "const": false },
        "principal_ref": { "type": "string", "minLength": 1 },
        "grant_ref": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "digest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "org_id": { "type": "string", "minLength": 1 },
        "scope_id": { "type": "string", "minLength": 1 },
        "task_id": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "command_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "valid_from": { "type": "integer" }, "valid_until": { "type": "integer" }
      }
    }
  ]
}
